<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MauiMonolith"
       x:Class="MauiMonolith.AppShell"
       FlyoutBehavior="Flyout"
       Title=".NET MAUI Cross-Platform">
    <FlyoutItem Title="Dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:AppDashboardPage}" Route="dashboard" />
    </FlyoutItem>
    <FlyoutItem Title="Resources">
        <ShellContent ContentTemplate="{DataTemplate views:ResourcesPage}" Route="resources" />
    </FlyoutItem>
    <FlyoutItem Title="Statistics">
        <ShellContent ContentTemplate="{DataTemplate views:StatsPage}" Route="stats" />
    </FlyoutItem>
    <FlyoutItem Title="Partition nodes">
        <ShellContent ContentTemplate="{DataTemplate views:NodesPage}" Route="nodes" />
    </FlyoutItem>
    <FlyoutItem Title="Health">
        <ShellContent ContentTemplate="{DataTemplate views:HealthPage}" Route="health" />
    </FlyoutItem>
    <FlyoutItem Title="Version">
        <ShellContent ContentTemplate="{DataTemplate views:VersionPage}" Route="version" />
    </FlyoutItem>
</Shell>
